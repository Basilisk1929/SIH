# ==============================================================================
# Cyber-Intelligence Platform - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# COMPLIANCE NOTICE:
# This project operates strictly in SYNTHETIC DATA MODE for development and
# SIH hackathon evaluation. Real NCRP/1930 and live Indian bank transaction data
# are strictly prohibited.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="CyberShield-Intel"
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security & Authentication (Replace in production via secure secret vault)
# NOTE: In development, if JWT_SECRET_KEY is omitted, backend generates a secure ephemeral key.
JWT_SECRET_KEY=dev_insecure_secret_key_change_in_production_min32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Relational Database (Complaints, Accounts, Audit Ledger)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyber_intelligence_db
POSTGRES_USER=cyber_admin
POSTGRES_PASSWORD=cyber_dev_password_123!
DATABASE_URL=postgresql+asyncpg://cyber_admin:cyber_dev_password_123!@localhost:5432/cyber_intelligence_db

# Neo4j Graph Database (Mule Account Networks, Entity Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cyber_graph_password_123!

# Redis Cache & Message Broker (Task Queue, Rate Limiting, Alert Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Synthetic Data & Simulation Settings
SYNTHETIC_DATA_ONLY=True
SYNTHETIC_SEED=42
DEFAULT_COMPLAINT_BATCH_SIZE=500
SIMULATE_STREAMING_TPS=5.0

# Machine Learning & NLP Inference
ML_MODEL_REGISTRY_PATH=./ml/models
MULE_RISK_THRESHOLD=0.75
GEO_CLUSTER_EPS_KM=15.0

# Frontend Configuration (Vite environment variables)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_TITLE="CyberShield Intelligence Platform"
