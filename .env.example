# ==============================================================================
# CyberShield-Intel Platform - Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS OR CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Deployment environment: 'development', 'staging', or 'production'
ENVIRONMENT=development
# Debug mode: Set to False in production
DEBUG=True
APP_NAME=CyberShield-Intel
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Server bindings for direct execution (e.g., uvicorn)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 2. CORS & NETWORKING CONFIGURATION
# ------------------------------------------------------------------------------
# Allowed origins for HTTP API requests (supports JSON array or comma-delimited strings)
# IMPORTANT: In production, specify your exact Vercel frontend domain(s).
# Wildcard '*' is strictly prohibited in production and will trigger startup failure.
# Example: ALLOWED_CORS_ORIGINS=["https://cybershield-intel.vercel.app","http://localhost:5173"]
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHY (JWT)
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: Minimum 32-character cryptographically random secret.
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_32bytes_minimum!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. POSTGRESQL RELATIONAL DATABASE
# ------------------------------------------------------------------------------
# Relational store for Users, Roles, Banks, Accounts, ATMs, Complaints, Transactions,
# Cases, Evidence, Notes, Timeline Events, Alerts, and Audit Logs.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyber_intelligence_db
POSTGRES_USER=cyber_admin
POSTGRES_PASSWORD=cyber_dev_password_123!

# SQLAlchemy async connection URL (requires postgresql+asyncpg:// driver)
DATABASE_URL=postgresql+asyncpg://cyber_admin:cyber_dev_password_123!@localhost:5432/cyber_intelligence_db

# ------------------------------------------------------------------------------
# 5. NEO4J GRAPH DATABASE
# ------------------------------------------------------------------------------
# Graph store for multi-hop money mule flow, ring detection, and entity resolution.
# For local Docker: bolt://localhost:7687 or bolt://neo4j:7687
# For Neo4j Aura: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cyber_graph_password_123!

# ------------------------------------------------------------------------------
# 6. REDIS IN-MEMORY CACHE & MESSAGE BROKER
# ------------------------------------------------------------------------------
# In-memory pub/sub message broker for real-time alert broadcasts and rate limits.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. INTELLIGENCE SUBSYSTEMS & COMPLIANCE GUARDRAILS
# ------------------------------------------------------------------------------
# ML, NLP, and Geo run unified in-process inside the backend modular monolith.
# Their endpoints are directly mounted at /risk/*, /nlp/*, /geo/* and /api/v1/*.
SYNTHETIC_DATA_ONLY=True
SYNTHETIC_SEED=42
MULE_RISK_THRESHOLD=0.75

# Automatically populate initial synthetic intelligence dataset on first boot
AUTO_SEED=true

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION (Vercel & Vite)
# ------------------------------------------------------------------------------
# Applied during frontend build or defined in Vercel Project Settings:
# For local Vite dev proxy: /api/v1 (or http://localhost:8000/api/v1)
# For Vercel production: https://<your-backend-domain>/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Real-time WebSocket Alert stream URL:
# For local Vite dev: ws://localhost:8000/alerts/ws
# For production: wss://<your-backend-domain>/alerts/ws
# If left empty, frontend automatically derives this from VITE_API_BASE_URL
VITE_WS_ALERT_URL=ws://localhost:8000/alerts/ws
