# CyberShield-Intel Platform Environment Configuration
# NEVER COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True
APP_NAME=CyberShield-Intel
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Server Bindings (Bind to 127.0.0.1 for local security)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated list, NO wildcard * in production)
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# JWT Secret & Cryptography (REQUIRED in production: min 32 characters, generated via CSPRNG)
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_32bytes_minimum!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database (Database credentials must be supplied via KMS / Vault in production)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyber_intelligence_db
POSTGRES_USER=cyber_admin
POSTGRES_PASSWORD=cyber_dev_password_123!
DATABASE_URL=postgresql+asyncpg://cyber_admin:cyber_dev_password_123!@localhost:5432/cyber_intelligence_db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cyber_graph_password_123!

# Redis Cache & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Regulatory Compliance & Synthetic Guardrails
SYNTHETIC_DATA_ONLY=True
SYNTHETIC_SEED=42
MULE_RISK_THRESHOLD=0.75
