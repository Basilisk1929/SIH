# ==============================================================================
# CyberShield-Intel Frontend Dockerfile - Multi-Stage Build (Dev & Prod)
# ==============================================================================

# --- Stage 1: Development Environment (Vite Dev Server) ---
FROM node:20-alpine AS dev

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# --- Stage 2: Production Build ---
FROM node:20-alpine AS builder

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm install

COPY frontend/ ./

ARG VITE_API_BASE_URL=/api/v1
ARG VITE_WS_ALERT_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_WS_ALERT_URL=$VITE_WS_ALERT_URL

RUN npm run build

# --- Stage 3: Production Web Server (NGINX Alpine) ---
FROM nginx:1.27-alpine AS production

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
