# CyberShield-Intel Frontend Environment Configuration
# Copy this file to .env.local or set variables in Vercel project settings

# Backend API base URL
# In local development via Vite proxy, '/api/v1' is standard.
# For Vercel production deployment, set to your backend host (e.g. https://api.cybershield.gov.in/api/v1)
VITE_API_BASE_URL=/api/v1

# Real-Time Alert WebSocket / SSE stream URL
# Local: ws://127.0.0.1:8000/alerts/ws
# Production: wss://api.cybershield.gov.in/alerts/ws
VITE_WS_ALERT_URL=ws://127.0.0.1:8000/alerts/ws

# Platform display environment mode
VITE_APP_ENV=SYNTHETIC_DEVELOPMENT
